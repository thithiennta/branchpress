#!/usr/bin/env bash
# branchpress — one disposable WordPress test site per plugin git worktree, backed by Docker.
#
# Every site gets its own WordPress container, its own database (cloned from a
# "snapshot" of realistic data) and its own URL, so several worktrees can be
# tested in the browser at the same time. Run `branchpress help` for usage.
set -euo pipefail

BP_VERSION="0.4.0"

# Each instance keeps its own settings folder, so two instances never prune each other's data.
if [ -n "${BRANCHPRESS_INSTANCE:-}" ] && [ "$BRANCHPRESS_INSTANCE" != branchpress ]; then
	BP_HOME="${BRANCHPRESS_HOME:-$HOME/.branchpress-$BRANCHPRESS_INSTANCE}"
else
	BP_HOME="${BRANCHPRESS_HOME:-$HOME/.branchpress}"
fi
CONF="$BP_HOME/config"
BRANCHPRESS_PLUGINS_DIR="${BRANCHPRESS_PLUGINS_DIR:-}"
BRANCHPRESS_DEFAULT_SNAPSHOT="${BRANCHPRESS_DEFAULT_SNAPSHOT:-}"
BRANCHPRESS_WP_IMAGE="${BRANCHPRESS_WP_IMAGE:-wordpress:php8.3-apache}"
BRANCHPRESS_DB_PORT="${BRANCHPRESS_DB_PORT:-3407}"
BRANCHPRESS_MAIL_PORT="${BRANCHPRESS_MAIL_PORT:-8025}"
BRANCHPRESS_AUTO_PRUNE="${BRANCHPRESS_AUTO_PRUNE:-1}"
BRANCHPRESS_ASK="${BRANCHPRESS_ASK:-1}"
# shellcheck disable=SC1090
[ -f "$CONF" ] && . "$CONF"

# Instance name: prefixes every container, volume and network (lets two setups coexist).
PFX="${BRANCHPRESS_INSTANCE:-branchpress}"
NET=$PFX
DB=$PFX-db
DB_PASS=branchpress
DB_PORT=$BRANCHPRESS_DB_PORT
MAIL=$PFX-mail
MAIL_PORT=$BRANCHPRESS_MAIL_PORT
PORT_MIN=8100
PORT_RANGE=900
ADMIN_USER=branchpress
ADMIN_PASS=branchpress
# Mailer plugins that could send real email through an API; deactivated on every clone.
MAILER_PLUGINS="wp-mail-smtp wp-mail-smtp-pro post-smtp fluent-smtp easy-wp-smtp yaysmtp sendgrid-email-delivery-simplified mailgun wp-ses"

SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
	t=$(readlink "$SELF")
	case $t in /*) SELF=$t ;; *) SELF=$(dirname "$SELF")/$t ;; esac
done
SELF="$(cd "$(dirname "$SELF")" && pwd -P)/$(basename "$SELF")"

# Cleanup on exit: temp folders, and a snapshot that failed halfway through.
tmp=""
PARTIAL_SNAP_DIR=""
PARTIAL_SNAP_DB=""
PARTIAL_DB=""
# rm_tree PATH: rm -rf that also removes the folders Docker Desktop creates as mount points
# (plugins/<slug>): it marks them "deny delete" with a macOS ACL, so drop ACLs and retry.
rm_tree() {
	rm -rf "$1" 2>/dev/null && return 0
	chmod -RN "$1" 2>/dev/null || true
	rm -rf "$1" 2>/dev/null && return 0
	printf '\033[33mwarn:\033[0m could not remove %s\n' "$1" >&2
	return 1
}

on_exit() {
	[ -n "$tmp" ] && { rm_tree "$tmp" || true; }
	[ -n "$PARTIAL_DB" ] && docker exec -e MYSQL_PWD="$DB_PASS" "$DB" mysql -uroot -e "DROP DATABASE IF EXISTS \`$PARTIAL_DB\`" >/dev/null 2>&1
	if [ -n "$PARTIAL_SNAP_DIR" ]; then
		rm_tree "$PARTIAL_SNAP_DIR" || true
		[ -n "$PARTIAL_SNAP_DB" ] && docker exec -e MYSQL_PWD="$DB_PASS" "$DB" mysql -uroot -e "DROP DATABASE IF EXISTS \`$PARTIAL_SNAP_DB\`" >/dev/null 2>&1
		printf '\033[33mwarn:\033[0m %s\n' "Snapshot was not created; partial files were removed" >&2
	fi
	return 0
}
trap on_exit EXIT

die()  { printf '\033[31merror:\033[0m %s\n' "$*" >&2; exit 1; }
info() { printf '\033[36m==>\033[0m %s\n' "$*" >&2; }
warn() { printf '\033[33mwarn:\033[0m %s\n' "$*" >&2; }

sql()        { docker exec -i -e MYSQL_PWD="$DB_PASS" "$DB" mysql -uroot "$@"; }
is_running() { [ "$(docker inspect -f '{{.State.Running}}' "$1" 2>/dev/null)" = "true" ]; }
exists()     { docker inspect "$1" >/dev/null 2>&1; }
db_ident()   { printf %s "$1" | tr '-' '_'; }

sanitize() {
	printf %s "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//' | cut -c1-50 | sed -E 's/-+$//'
}

# conf_get FILE KEY -> every value of KEY=... in a .branchpress file, one per line.
conf_get() { [ -f "$1" ] || return 0; grep -E "^$2=" "$1" | sed "s/^$2=//" || true; }

open_url() {
	if command -v open >/dev/null && [ "$(uname)" = Darwin ]; then open "$1"
	elif command -v xdg-open >/dev/null; then xdg-open "$1" >/dev/null 2>&1
	else info "Open: $1"; fi
}

read_sql() { case $1 in *.gz) gzip -dc "$1" ;; *) cat "$1" ;; esac; }

# ---------------------------------------------------------------------------
# Infrastructure: shared network, MySQL and Mailpit
# ---------------------------------------------------------------------------

require_docker() {
	command -v docker >/dev/null || die "Docker not found. Install OrbStack (recommended on macOS) or Docker Desktop."
	docker info >/dev/null 2>&1 || die "Docker is installed but not running. Start OrbStack/Docker Desktop and retry."
}

start_or_create() { # name, then `docker run` args
	local name=$1; shift
	is_running "$name" && return 0
	if exists "$name"; then docker start "$name" >/dev/null; else docker run -d --name "$name" "$@" >/dev/null; fi
}

ensure_infra() {
	require_docker
	[ -x "$BP_HOME/bin/wp" ] || die "branchpress is not set up yet. Run: branchpress setup"
	docker network inspect "$NET" >/dev/null 2>&1 || docker network create "$NET" >/dev/null
	# v0.1 ran MySQL with the binary log on, which keeps a 30-day copy of every clone.
	local binlog_cleanup=""
	if exists "$DB" && ! docker inspect -f '{{join .Args " "}}' "$DB" | grep -q -- '--skip-log-bin'; then
		info "Recreating $DB without the binary log (data is kept)"
		docker rm -f "$DB" >/dev/null
		binlog_cleanup=1
	fi
	start_or_create "$DB" --network "$NET" --restart unless-stopped \
		-e MYSQL_ROOT_PASSWORD="$DB_PASS" -v "$PFX-db-data:/var/lib/mysql" \
		-p "127.0.0.1:$DB_PORT:3306" mysql:8.4 \
		--skip-log-bin --max-allowed-packet=1G --innodb-buffer-pool-size=512M
	start_or_create "$MAIL" --network "$NET" --restart unless-stopped \
		-p "127.0.0.1:$MAIL_PORT:8025" axllent/mailpit
	# The MySQL image runs a temporary server (port 0) during first init; wait for the real one.
	local i=0
	until docker logs "$DB" 2>&1 | grep -q 'ready for connections.*port: 3306' &&
		sql -N -e 'SELECT 1' >/dev/null 2>&1; do
		i=$((i + 1))
		[ $i -gt 120 ] && die "MySQL did not become ready. Check: docker logs $DB"
		sleep 1
	done
	if [ -n "$binlog_cleanup" ]; then
		docker exec "$DB" sh -c 'rm -f /var/lib/mysql/binlog.[0-9]* /var/lib/mysql/binlog.index'
	fi
}

write_mu_plugin() {
	cat >"$BP_HOME/mu-plugins/branchpress.php" <<'PHP'
<?php
/**
 * Plugin Name: branchpress local helpers
 * Description: Sends all mail to Mailpit and adds ?branchpress_login=1 auto-login. Mounted only into branchpress containers.
 */

if ( 'local' !== wp_get_environment_type() ) {
	return;
}

add_action(
	'phpmailer_init',
	function ( $mailer ) {
		$mailer->isSMTP();
		$mailer->Host        = getenv( 'BRANCHPRESS_MAIL_HOST' ) ?: 'branchpress-mail';
		$mailer->Port        = 1025;
		$mailer->SMTPAuth    = false;
		$mailer->SMTPAutoTLS = false;
		$mailer->SMTPSecure  = '';
	},
	PHP_INT_MAX
);

add_action(
	'init',
	function () {
		if ( empty( $_GET['branchpress_login'] ) || is_user_logged_in() ) {
			return;
		}
		$user = get_user_by( 'login', 'branchpress' );
		if ( ! $user ) {
			return;
		}
		wp_set_current_user( $user->ID );
		wp_set_auth_cookie( $user->ID, true );
		wp_safe_redirect( remove_query_arg( 'branchpress_login' ) );
		exit;
	}
);
PHP
}

cmd_setup() {
	local quiet=""
	[ "${1:-}" = "--quiet" ] && quiet=1
	require_docker
	mkdir -p "$BP_HOME/snapshots" "$BP_HOME/sites" "$BP_HOME/bin" "$BP_HOME/mu-plugins"
	if [ ! -f "$CONF" ]; then
		cat >"$CONF" <<'EOF'
# branchpress config (sourced as shell — use "$HOME", not "~").

# Folder that contains your plugin repos; used by `branchpress up --with <slug>[@branch]`.
BRANCHPRESS_PLUGINS_DIR=""

# Snapshot used by `branchpress up` when none is given.
BRANCHPRESS_DEFAULT_SNAPSHOT=""

# With several snapshots, `up` asks which one a plugin uses (once per plugin; see `branchpress use`).
# Set to 0 to use the default snapshot without asking (CI, scripts).
# BRANCHPRESS_ASK=1

# WordPress image: pick PHP/WP version here, e.g. wordpress:6.8-php8.2-apache
BRANCHPRESS_WP_IMAGE="wordpress:php8.3-apache"

# Host ports for the shared MySQL and Mailpit (change if they clash with something).
# BRANCHPRESS_DB_PORT=3407
# BRANCHPRESS_MAIL_PORT=8025
EOF
		info "Wrote $CONF"
	fi
	if [ ! -x "$BP_HOME/bin/wp" ]; then
		info "Downloading WP-CLI"
		curl -fsSL https://raw.githubusercontent.com/wp-cli/builds/gh-pages/phar/wp-cli.phar -o "$BP_HOME/bin/wp"
		chmod +x "$BP_HOME/bin/wp"
	fi
	write_mu_plugin
	info "Pulling Docker images (first time can take a few minutes)"
	docker pull -q "$BRANCHPRESS_WP_IMAGE" >/dev/null
	docker pull -q mysql:8.4 >/dev/null
	docker pull -q axllent/mailpit >/dev/null
	info "Starting shared MySQL and Mailpit"
	ensure_infra

	mkdir -p "$HOME/.local/bin"
	ln -sf "$SELF" "$HOME/.local/bin/branchpress"
	ln -sf "$SELF" "$HOME/.local/bin/bpress"
	case ":$PATH:" in
		*":$HOME/.local/bin:"*) ;;
		*) warn "~/.local/bin is not on PATH. Run: echo 'export PATH=\"\$HOME/.local/bin:\$PATH\"' >> ~/.zshrc && exec zsh" ;;
	esac
	[ -n "$quiet" ] && return 0
	cat <<EOF

branchpress is ready.
  Config:   $CONF
  MySQL:    127.0.0.1:$DB_PORT  (root / $DB_PASS)
  Mailpit:  http://localhost:$MAIL_PORT

Next: add a data snapshot (branchpress snapshot help), then run 'branchpress up' inside a plugin worktree.
EOF
}

# ---------------------------------------------------------------------------
# Worktree context
# ---------------------------------------------------------------------------

slug_of() { # plugin folder -> plugin slug (.branchpress slug=, else main repo folder name)
	local p=$1 s common
	s=$(conf_get "$p/.branchpress" slug | tail -1)
	if [ -z "$s" ]; then
		if common=$(git -C "$p" rev-parse --path-format=absolute --git-common-dir 2>/dev/null); then
			s=$(basename "$(dirname "$common")")
		else
			s=$(basename "$p")
		fi
	fi
	printf %s "$s"
}

detect() {
	WT_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || die "Not inside a git repo. cd into a plugin worktree first."
	SLUG=$(slug_of "$WT_ROOT")
	BRANCH=$(git -C "$WT_ROOT" branch --show-current)
	[ -n "$BRANCH" ] || BRANCH=$(git -C "$WT_ROOT" rev-parse --short HEAD)
	set_site "$(sanitize "$SLUG-$BRANCH")"
}

set_site() {
	NAME=$1
	C="$PFX-$NAME"
	STATE="$BP_HOME/sites/$NAME.env"
	DBNAME="site_$(db_ident "$NAME")"
}

load_state() {
	S_PORT="" S_URL="" S_SNAPSHOT="" S_WORKTREE="" S_WITH=""
	# shellcheck disable=SC1090
	[ -f "$STATE" ] && . "$STATE"
	return 0
}

# resolve_with SPEC -> "slug|path". SPEC is a folder, or slug[@branch] looked up in BRANCHPRESS_PLUGINS_DIR.
# Without @branch, a worktree of that plugin on the *same branch name* as the current one wins,
# otherwise the plugin's main checkout is used.
resolve_with() {
	local spec=$1 slug branch="" repo path want
	if [ -d "$spec" ]; then
		path=$(cd "$spec" && pwd -P)
		printf '%s|%s\n' "$(slug_of "$path")" "$path"
		return
	fi
	slug=${spec%%@*}
	case $spec in *@*) branch=${spec#*@} ;; esac
	[ -n "$BRANCHPRESS_PLUGINS_DIR" ] || die "--with $spec needs BRANCHPRESS_PLUGINS_DIR in $CONF (or pass a folder path)."
	repo="$BRANCHPRESS_PLUGINS_DIR/$slug"
	git -C "$repo" rev-parse >/dev/null 2>&1 || die "No git repo at $repo"
	want=${branch:-$BRANCH}
	path=$(git -C "$repo" worktree list --porcelain |
		awk -v b="branch refs/heads/$want" '/^worktree /{p=substr($0,10)} $0==b{print p; exit}')
	if [ -z "$path" ]; then
		[ -n "$branch" ] && die "$slug has no worktree on branch '$branch'. Create one: git -C \"$repo\" worktree add <folder> $branch"
		path=$repo
	fi
	printf '%s|%s\n' "$slug" "$path"
}

pick_port() {
	local p
	p=$((PORT_MIN + $(printf %s "$NAME" | cksum | cut -d' ' -f1) % PORT_RANGE))
	while lsof -nP -iTCP:"$p" -sTCP:LISTEN >/dev/null 2>&1 ||
		grep -qsx "S_PORT=$p" "$BP_HOME"/sites/*.env; do
		p=$((p + 1))
		[ $p -ge $((PORT_MIN + PORT_RANGE)) ] && p=$PORT_MIN
	done
	echo "$p"
}

load_snapshot() {
	SNAP_DIR="$BP_HOME/snapshots/$1"
	[ -f "$SNAP_DIR/meta" ] || die "Snapshot '$1' not found. List them: branchpress snapshot ls"
	SNAP_URL="" SNAP_PREFIX="wp_" SNAP_WPCONTENT="" SNAP_DB="" SNAP_CREATED=""
	SNAP_SOURCE="" SNAP_SOURCE_WPCONTENT="" SNAP_SANITIZED="" SNAP_REFRESHED=""
	# shellcheck disable=SC1091
	. "$SNAP_DIR/meta"
	# Snapshots made before v0.4 don't record their source; guess it from the URL.
	if [ -z "$SNAP_SOURCE" ]; then
		if [ -z "$SNAP_URL" ]; then SNAP_SOURCE=empty
		else
			local l
			l=$(local_match "$SNAP_URL")
			[ -n "$l" ] && SNAP_SOURCE="local:$l"
		fi
	fi
	return 0
}

describe_source() { # of the loaded snapshot
	case $SNAP_SOURCE in
		local:*) echo "Local site ${SNAP_SOURCE#local:}" ;;
		import:*) echo "file $(basename "${SNAP_SOURCE#import:}")" ;;
		sql:*) echo "dump $(basename "${SNAP_SOURCE#sql:}")" ;;
		empty) echo "empty WordPress" ;;
		*) echo "unknown source" ;;
	esac
}

snap_names() {
	local d
	for d in "$BP_HOME"/snapshots/*/; do [ -f "$d/meta" ] && basename "$d"; done
	return 0
}

url_host() { local h=${1#*://}; h=${h%%/*}; h=${h%%:*}; printf %s "$h" | tr '[:upper:]' '[:lower:]'; }

# snap_match HINT -> the local snapshot HINT refers to: by name, or by the domain it was copied from.
snap_match() {
	local hint=$1 n h d
	n=$(sanitize "$hint")
	for d in "$hint" "$n"; do
		[ -n "$d" ] && [ -f "$BP_HOME/snapshots/$d/meta" ] && { echo "$d"; return 0; }
	done
	h=$(url_host "$hint")
	for d in "$BP_HOME"/snapshots/*/; do
		[ -f "$d/meta" ] || continue
		# shellcheck disable=SC1091
		if (SNAP_URL="" SNAP_SOURCE="" && . "$d/meta" && { [ "$(url_host "$SNAP_URL")" = "$h" ] || [ "$SNAP_SOURCE" = "local:$hint" ]; }); then
			basename "$d"
			return 0
		fi
	done
	return 0
}

# Per-developer choice of snapshot for each plugin (written by `branchpress use` or the up prompt).
SNAP_MAP="$BP_HOME/plugin-snapshots"
map_get() { conf_get "$SNAP_MAP" "$1" | tail -1; }
map_del() {
	[ -f "$SNAP_MAP" ] || return 0
	awk -F= -v k="$1" '$1 != k' "$SNAP_MAP" >"$SNAP_MAP.tmp" && mv "$SNAP_MAP.tmp" "$SNAP_MAP"
}
map_set() { map_del "$1"; printf '%s=%s\n' "$1" "$2" >>"$SNAP_MAP"; }

# resolve_snapshot FLAG -> sets SNAPSHOT and SNAP_WHY for the current worktree. Order:
# --snapshot, what this site used before, your choice for the plugin, snapshot= in .branchpress
# (a name or the team's dev-site domain), the only snapshot; otherwise ask.
resolve_snapshot() {
	local hint m n count only=""
	SNAPSHOT="" SNAP_WHY=""
	if [ -n "$1" ]; then SNAPSHOT=$1 SNAP_WHY="--snapshot"; return; fi
	if [ -n "$S_SNAPSHOT" ] && [ -f "$BP_HOME/snapshots/$S_SNAPSHOT/meta" ]; then
		SNAPSHOT=$S_SNAPSHOT SNAP_WHY="this site's data"
		return
	fi
	m=$(map_get "$SLUG")
	if [ -n "$m" ]; then
		if [ -f "$BP_HOME/snapshots/$m/meta" ]; then SNAPSHOT=$m SNAP_WHY="your choice for $SLUG"; return; fi
		warn "Snapshot '$m' chosen for $SLUG no longer exists"
		map_del "$SLUG"
	fi
	hint=$(conf_get "$WT_ROOT/.branchpress" snapshot | tail -1)
	if [ -n "$hint" ]; then
		n=$(snap_match "$hint")
		if [ -n "$n" ]; then
			SNAPSHOT=$n SNAP_WHY="matches snapshot=$hint in .branchpress"
			map_set "$SLUG" "$n"
			return
		fi
	fi
	count=$(snap_names | wc -l | tr -d ' ')
	[ "$count" -gt 0 ] || die "No snapshot yet. Create one: branchpress use --from-local SITE | --import FILE.tar.gz | --empty"
	[ "$count" -eq 1 ] && only=$(snap_names)
	if [ -n "$only" ] && { [ -z "$hint" ] || [ -z "$(local_match "$hint")" ]; }; then
		[ -n "$hint" ] && warn ".branchpress asks for '$hint', which isn't on this machine; using '$only'. Pick another: branchpress use --from-local SITE | --import FILE"
		SNAPSHOT=$only SNAP_WHY="the only snapshot"
		return
	fi
	if [ "$BRANCHPRESS_ASK" = 0 ] && [ -f "$BP_HOME/snapshots/$BRANCHPRESS_DEFAULT_SNAPSHOT/meta" ]; then
		SNAPSHOT=$BRANCHPRESS_DEFAULT_SNAPSHOT SNAP_WHY="default"
		return
	fi
	choose_snapshot "$hint"
}

# choose_snapshot HINT: ask which data $SLUG uses and remember it. Without a terminal, print the
# choices and exit 3 so the caller (a person or Claude) can decide and run `branchpress use`.
choose_snapshot() {
	local hint=$1 suggest="" names=() kinds=() labels=() n name domain def="" i k choice file state
	[ -n "$hint" ] && suggest=$(local_match "$hint")
	for n in $(snap_names); do
		load_snapshot "$n"
		names+=("$n") kinds+=(snap) labels+=("$n — $(describe_source)${SNAP_URL:+, $SNAP_URL}")
		[ "$n" = "$BRANCHPRESS_DEFAULT_SNAPSHOT" ] && [ -z "$suggest" ] && def=${#names[@]}
	done
	while IFS='|' read -r _ name domain _; do
		[ -n "$name" ] || continue
		[ -n "$(snap_match "$domain")" ] || [ -n "$(snap_match "$name")" ] && continue
		state=""
		local_running "$name" || state=", not running"
		names+=("$name") kinds+=(local) labels+=("copy Local site $name ($domain$state)")
		[ "$name" = "$suggest" ] && def=${#names[@]}
	done < <(local_sites)
	k=${#names[@]}

	if [ -z "$HAS_TTY" ] || [ -n "$INIT_YES" ]; then
		{
			printf '\033[33mchoose:\033[0m Which test data should plugin %s use?' "$SLUG"
			[ -n "$hint" ] && printf " (.branchpress asks for '%s', which isn't on this machine)" "$hint"
			printf '\n'
			for i in $(seq 1 "$k"); do
				printf '  - %s%s\n' "${labels[$((i - 1))]}" "$([ "$i" = "$def" ] && echo '   (suggested)')"
			done
			cat <<EOF
Decide, then run one of these and retry:
  branchpress use NAME                    use an existing snapshot
  branchpress use --from-local SITE       copy a Local site (it must be running)
  branchpress use --import FILE.tar.gz    load a teammate's export
  branchpress use --empty                 empty WordPress
EOF
		} >&2
		exit 3
	fi

	printf '\n  Which test data should \033[1m%s\033[0m use?\n' "$SLUG" >&2
	[ -n "$hint" ] && printf "  (.branchpress asks for '%s', which isn't on this machine)\n" "$hint" >&2
	for i in $(seq 1 "$k"); do printf '    %d) %s\n' "$i" "${labels[$((i - 1))]}" >&2; done
	printf '    %d) import a teammate file (.tar.gz)\n    %d) empty WordPress\n' $((k + 1)) $((k + 2)) >&2
	choice=$(ask "Choose" "${def:-1}")
	case $choice in '' | *[!0-9]*) die "Invalid choice: $choice" ;; esac
	INIT_RUNNING=1
	if [ "$choice" -ge 1 ] && [ "$choice" -le "$k" ]; then
		name=${names[$((choice - 1))]}
		if [ "${kinds[$((choice - 1))]}" = snap ]; then INIT_SNAPSHOT=$name
		else wait_local "$name"; init_snapshot "" "$name" ""; fi
	elif [ "$choice" -eq $((k + 1)) ]; then
		file=$(ask "Path to the .tar.gz file (you can drag it here)" "")
		[ -n "$file" ] || die "No file given"
		init_snapshot "$file" "" ""
	elif [ "$choice" -eq $((k + 2)) ]; then
		init_snapshot "" "" 1
	else
		die "Invalid choice: $choice"
	fi
	SNAPSHOT=$INIT_SNAPSHOT SNAP_WHY="your choice for $SLUG"
	map_set "$SLUG" "$SNAPSHOT"
	info "Saved: $SLUG uses '$SNAPSHOT' (change it with: branchpress use NAME)"
}

wpc() { docker exec -i -u www-data -e HOME=/tmp -w /var/www/html "$C" wp "$@"; }

# ---------------------------------------------------------------------------
# Site lifecycle
# ---------------------------------------------------------------------------

cmd_up() {
	auto_prune
	detect
	load_state
	local snapshot="" fresh="" open_it="" withs=() given_with="" w
	while [ $# -gt 0 ]; do
		case $1 in
			--snapshot) snapshot=${2:?}; shift 2 ;;
			--with) withs+=("${2:?}"); given_with=1; shift 2 ;;
			--fresh) fresh=1; shift ;;
			--open) open_it=1; shift ;;
			*) die "Unknown option: $1 (see: branchpress help)" ;;
		esac
	done

	resolve_snapshot "$snapshot"
	snapshot=$SNAPSHOT
	[ -n "$S_SNAPSHOT" ] && [ "$S_SNAPSHOT" != "$snapshot" ] && fresh=1
	load_snapshot "$snapshot"
	local data_desc
	data_desc="$(describe_source), copied ${SNAP_REFRESHED:-$SNAP_CREATED}"

	# Companion plugins: --with flags, else what this site used last time, else `with=` lines in .branchpress.
	if [ -z "$given_with" ]; then
		if [ -n "$S_WITH" ]; then
			IFS=';' read -r -a withs <<<"$S_WITH"
		else
			while IFS= read -r w; do [ -n "$w" ] && withs+=("$w"); done < <(conf_get "$WT_ROOT/.branchpress" with)
		fi
	fi

	ensure_infra
	info "Site $NAME — data: $snapshot ($data_desc) [$SNAP_WHY]"
	local mounts=(-v "$WT_ROOT:/var/www/html/wp-content/plugins/$SLUG") activate=("$SLUG") pair s p
	info "  plugin $SLUG → $WT_ROOT"
	for w in ${withs[@]+"${withs[@]}"}; do
		pair=$(resolve_with "$w")
		s=${pair%%|*}
		p=${pair#*|}
		mounts+=(-v "$p:/var/www/html/wp-content/plugins/$s")
		activate+=("$s")
		info "  plugin $s → $p ($(git -C "$p" branch --show-current 2>/dev/null || echo 'no git'))"
	done

	docker rm -f "$C" >/dev/null 2>&1 || true
	local port=$S_PORT
	if [ -z "$port" ] || lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1; then port=$(pick_port); fi
	local host="$NAME.localhost"
	local url="http://$host:$port"
	local joined="" k
	for k in ${withs[@]+"${withs[@]}"}; do joined="${joined:+$joined;}$k"; done
	# Written before the build so `snapshot rm` sees this site even while it is starting.
	write_state "$port" "$url" "$snapshot" "$joined"

	local cloned=""
	if [ -n "$fresh" ] || [ -z "$(sql -N -e "SHOW DATABASES LIKE '$DBNAME'")" ]; then
		info "Cloning database from snapshot (large shops can take a minute)"
		sql -e "DROP DATABASE IF EXISTS \`$DBNAME\`; CREATE DATABASE \`$DBNAME\`;"
		docker exec -e MYSQL_PWD="$DB_PASS" "$DB" sh -c \
			"mysqldump -uroot --single-transaction --routines --triggers --no-tablespaces --set-gtid-purged=OFF '$SNAP_DB' | mysql -uroot '$DBNAME'"
		cloned=1
	fi

	local extra="define('WP_HOME', '$url');
define('WP_SITEURL', '$url');
define('WP_ENVIRONMENT_TYPE', 'local');
define('WP_DEBUG_LOG', '/var/www/html/debug.log');
define('WP_DEBUG_DISPLAY', false);
define('SCRIPT_DEBUG', true);
define('FS_METHOD', 'direct');
define('AUTOMATIC_UPDATER_DISABLED', true);"

	# Apache listens on the published port itself, so WordPress loopback requests
	# (cron, REST, site health) to $url also work from inside the container.
	docker run -d --name "$C" --network "$NET" \
		--label "$PFX.site=$NAME" -e BRANCHPRESS_MAIL_HOST="$MAIL" \
		-p "127.0.0.1:$port:$port" --add-host "$host:127.0.0.1" \
		-e WORDPRESS_DB_HOST="$DB" -e WORDPRESS_DB_USER=root -e WORDPRESS_DB_PASSWORD="$DB_PASS" \
		-e WORDPRESS_DB_NAME="$DBNAME" -e WORDPRESS_TABLE_PREFIX="$SNAP_PREFIX" -e WORDPRESS_DEBUG=1 \
		-e WORDPRESS_CONFIG_EXTRA="$extra" \
		-v "$PFX-core-$NAME:/var/www/html" \
		-v "$SNAP_WPCONTENT:/var/www/html/wp-content" \
		-v "$BP_HOME/mu-plugins/branchpress.php:/var/www/html/wp-content/mu-plugins/branchpress.php:ro" \
		-v "$BP_HOME/bin/wp:/usr/local/bin/wp:ro" \
		"${mounts[@]}" \
		--entrypoint bash "$BRANCHPRESS_WP_IMAGE" -c \
		"sed -i 's/^Listen 80\$/Listen $port/' /etc/apache2/ports.conf &&
		 sed -i 's/<VirtualHost \*:80>/<VirtualHost *:$port>/' /etc/apache2/sites-enabled/000-default.conf &&
		 exec docker-entrypoint.sh apache2-foreground" >/dev/null

	local i=0
	until docker exec "$C" test -f /var/www/html/wp-config.php 2>/dev/null &&
		curl -fsS -o /dev/null --resolve "$host:$port:127.0.0.1" "$url/wp-includes/images/blank.gif" 2>/dev/null; do
		is_running "$C" || die "Container exited. Check: docker logs $C"
		i=$((i + 1))
		[ $i -gt 120 ] && die "Site did not come up. Check: docker logs $C"
		sleep 1
	done

	local skip=(--skip-plugins --skip-themes)
	if ! wpc core is-installed "${skip[@]}" >/dev/null 2>&1; then
		info "Installing fresh WordPress"
		wpc core install --url="$url" --title="$NAME" --admin_user="$ADMIN_USER" --admin_password="$ADMIN_PASS" \
			--admin_email="$ADMIN_USER@example.test" --skip-email "${skip[@]}" >/dev/null
	elif [ -n "$cloned" ]; then
		if [ -n "$SNAP_URL" ]; then
			info "Rewriting URLs $SNAP_URL → $url"
			local old=${SNAP_URL#*://} scheme
			old=${old%/}
			for scheme in https http; do
				wpc search-replace "$scheme://$old" "$url" --all-tables-with-prefix --skip-columns=guid --quiet "${skip[@]}" || true
				wpc search-replace "$scheme:\\/\\/$old" "${url//\//\\/}" --all-tables-with-prefix --skip-columns=guid --quiet "${skip[@]}" || true
			done
		fi
		# shellcheck disable=SC2086
		wpc plugin deactivate $MAILER_PLUGINS "${skip[@]}" >/dev/null 2>&1 || true
		wpc core update-db "${skip[@]}" >/dev/null 2>&1 || true
	fi
	if wpc user get "$ADMIN_USER" --field=ID "${skip[@]}" >/dev/null 2>&1; then
		wpc user update "$ADMIN_USER" --user_pass="$ADMIN_PASS" --role=administrator --skip-email "${skip[@]}" >/dev/null
	else
		wpc user create "$ADMIN_USER" "$ADMIN_USER@example.test" --role=administrator --user_pass="$ADMIN_PASS" "${skip[@]}" >/dev/null
	fi
	wpc plugin activate "${activate[@]}" >/dev/null 2>&1 || warn "Could not activate all of: ${activate[*]} — check with: branchpress wp plugin list"
	[ -n "$cloned" ] && { wpc wc update >/dev/null 2>&1 || true; }
	wpc rewrite flush --hard >/dev/null 2>&1 || true

	cat <<EOF

✔ $NAME is up
  Site:    $url
  Admin:   $url/wp-admin/?branchpress_login=1   (or log in: $ADMIN_USER / $ADMIN_PASS)
  Data:    $snapshot — $data_desc
  Mail:    http://localhost:$MAIL_PORT
  PHP log: branchpress logs --php
EOF
	if [ -n "$open_it" ]; then open_url "$url/wp-admin/?branchpress_login=1"; fi
}

write_state() { # port url snapshot with
	{
		printf 'S_NAME=%q\n' "$NAME"
		printf 'S_PORT=%q\n' "$1"
		printf 'S_URL=%q\n' "$2"
		printf 'S_SNAPSHOT=%q\n' "$3"
		printf 'S_WORKTREE=%q\n' "$WT_ROOT"
		printf 'S_WITH=%q\n' "$4"
	} >"$STATE"
}

teardown() { # name [purge]
	set_site "$1"
	docker rm -f "$C" >/dev/null 2>&1 || true
	if [ -n "${2:-}" ]; then
		if is_running "$DB"; then sql -e "DROP DATABASE IF EXISTS \`$DBNAME\`" || true; fi
		docker volume rm "$PFX-core-$NAME" >/dev/null 2>&1 || true
		rm -f "$STATE"
		info "Removed $NAME (container, database, state)"
	else
		info "Stopped $NAME (database kept; 'branchpress up' resumes it)"
	fi
}

cmd_down() {
	local purge=""
	[ "${1:-}" = "--purge" ] && purge=1
	detect
	teardown "$NAME" "$purge"
}

cmd_ls() {
	is_running "$DB" && auto_prune
	local f any="" st
	printf '%-42s %-8s %-40s %s\n' SITE STATUS URL WORKTREE
	for f in "$BP_HOME"/sites/*.env; do
		[ -f "$f" ] || continue
		any=1
		(
			# shellcheck disable=SC1090
			. "$f"
			st=stopped
			is_running "$PFX-$S_NAME" && st=running
			[ -d "$S_WORKTREE" ] || st=orphan
			printf '%-42s %-8s %-40s %s\n' "$S_NAME" "$st" "$S_URL" "$S_WORKTREE"
		)
	done
	[ -n "$any" ] || echo "(no sites yet — run 'branchpress up' inside a plugin worktree)"
}

# prune [--quiet]: delete sites whose worktree is gone, plus databases/volumes no site owns.
cmd_prune() {
	local quiet=${1:-} f n w count=0 db vol
	for f in "$BP_HOME"/sites/*.env; do
		[ -f "$f" ] || continue
		n=$(. "$f"; echo "$S_NAME")
		w=$(. "$f"; echo "$S_WORKTREE")
		if [ ! -d "$w" ]; then
			[ -n "$quiet" ] && info "Worktree for $n is gone; removing its site"
			teardown "$n" purge
			count=$((count + 1))
		fi
	done
	# Leftovers without a state file (e.g. state deleted by hand). `up` writes state before
	# creating the DB and volume, so a site that is still starting is never matched here.
	if is_running "$DB"; then
		local owned=" "
		for f in "$BP_HOME"/sites/*.env; do
			[ -f "$f" ] || continue
			owned="$owned site_$(db_ident "$(. "$f"; echo "$S_NAME")") "
		done
		for db in $(sql -N -e "SHOW DATABASES LIKE 'site\\_%'"); do
			case $owned in *" $db "*) continue ;; esac
			sql -e "DROP DATABASE \`$db\`"
			info "Dropped stray database $db"
			count=$((count + 1))
		done
	fi
	for vol in $(docker volume ls -q --filter "name=$PFX-core-"); do
		n=${vol#"$PFX"-core-}
		[ -f "$BP_HOME/sites/$n.env" ] && continue
		exists "$PFX-$n" && continue
		docker volume rm "$vol" >/dev/null 2>&1 && { info "Removed stray volume $vol"; count=$((count + 1)); }
	done
	[ -n "$quiet" ] && [ $count -eq 0 ] && return 0
	info "Pruned $count item(s)"
}

auto_prune() {
	[ "$BRANCHPRESS_AUTO_PRUNE" = "1" ] || return 0
	# Subshell: teardown overwrites the current-site globals.
	( cmd_prune --quiet ) || warn "Auto-prune failed; run: branchpress prune"
}

cmd_du() {
	ensure_infra
	local f d orphans="" sizes vols
	# stats_expiry=0: information_schema caches table sizes for 24h by default.
	sizes=$(sql -N -e "SET SESSION information_schema_stats_expiry=0;
		SELECT table_schema, ROUND(SUM(data_length + index_length) / 1048576) FROM information_schema.tables
		WHERE table_schema LIKE 'site\\_%' OR table_schema LIKE 'snap\\_%' GROUP BY table_schema")
	vols=$(docker system df -v 2>/dev/null | awk -v p="$PFX-core-" 'index($1, p) == 1 {print $1, $NF}')
	db_mb() { echo "$sizes" | awk -v d="$1" '$1==d {mb=$2} END {print (mb == "" ? 0 : mb) " MB"}'; }

	echo "Snapshots — shared by every site cloned from them; removed only by 'branchpress snapshot rm'"
	printf '  %-30s %10s %12s\n' NAME DATABASE WP-CONTENT
	for d in "$BP_HOME"/snapshots/*/; do
		[ -f "$d/meta" ] || continue
		(
			. "$d/meta"
			wpc=$(du -sh "$SNAP_WPCONTENT" 2>/dev/null | cut -f1)
			case $SNAP_WPCONTENT in "$BP_HOME"/*) ;; *) wpc="$wpc (linked)" ;; esac
			printf '  %-30s %10s %12s\n' "$(basename "$d")" "$(db_mb "$SNAP_DB")" "$wpc"
		)
	done
	echo
	echo "Sites — each is one database copy + WordPress core; wp-content is shared from the snapshot"
	printf '  %-42s %-8s %10s %8s\n' SITE STATUS DATABASE CORE
	for f in "$BP_HOME"/sites/*.env; do
		[ -f "$f" ] || continue
		(
			. "$f"
			st=stopped
			is_running "$PFX-$S_NAME" && st=running
			[ -d "$S_WORKTREE" ] || st=orphan
			printf '  %-42s %-8s %10s %8s\n' "$S_NAME" "$st" "$(db_mb "site_$(db_ident "$S_NAME")")" \
				"$(echo "$vols" | awk -v v="$PFX-core-$S_NAME" '$1==v {print $2}')"
		)
		[ -d "$(. "$f"; echo "$S_WORKTREE")" ] || orphans=1
	done
	echo
	echo "Shared"
	printf '  %-30s %s\n' "MySQL data (all databases)" "$(docker exec "$DB" du -sh /var/lib/mysql | cut -f1)"
	docker image ls --format '{{.Repository}}:{{.Tag}} {{.Size}}' |
		awk -v wp="$BRANCHPRESS_WP_IMAGE" '$1==wp || $1=="mysql:8.4" || $1=="axllent/mailpit:latest" {printf "  %-30s %s\n", "image " $1, $2}'
	if [ -n "$orphans" ]; then
		echo
		echo "Sites marked 'orphan' belong to deleted worktrees. Free them with: branchpress prune"
	fi
}

cmd_halt() {
	local ids
	ids=$(docker ps -q --filter "label=$PFX.site")
	[ -n "$ids" ] && docker stop $ids >/dev/null
	docker stop "$DB" "$MAIL" >/dev/null 2>&1 || true
	info "Stopped all branchpress containers (data kept)"
}

require_site() {
	detect
	load_state
	[ -f "$STATE" ] || die "No site for this worktree yet. Run: branchpress up"
}

cmd_url()  { require_site; echo "$S_URL"; }
cmd_open() { require_site; open_url "$S_URL/wp-admin/?branchpress_login=1"; }

cmd_wp() {
	require_site
	is_running "$C" || die "Site is stopped. Run: branchpress up"
	local t=()
	[ -t 0 ] && [ -t 1 ] && t=(-t)
	docker exec -i ${t[@]+"${t[@]}"} -u www-data -e HOME=/tmp -w /var/www/html "$C" wp "$@"
}

cmd_sql() {
	require_site
	local t=()
	[ -t 0 ] && t=(-t)
	docker exec -i ${t[@]+"${t[@]}"} -e MYSQL_PWD="$DB_PASS" "$DB" mysql -uroot "$DBNAME" "$@"
}

cmd_logs() {
	require_site
	if [ "${1:-}" = "--php" ]; then
		docker exec "$C" sh -c 'touch /var/www/html/debug.log && tail -n 100 -f /var/www/html/debug.log'
	else
		docker logs -f --tail 100 "$C"
	fi
}

# ---------------------------------------------------------------------------
# Snapshots: a database + wp-content that every site is cloned from
# ---------------------------------------------------------------------------

snap_sanitize() { # db prefix
	local d=$1 p=$2 t
	info "Sanitizing customer emails (admins keep theirs)"
	sql "$d" <<SQL
UPDATE \`${p}users\` SET user_email = CONCAT('user', ID, '@example.test')
 WHERE ID NOT IN (SELECT user_id FROM (SELECT user_id FROM \`${p}usermeta\`
   WHERE meta_key = '${p}capabilities' AND meta_value LIKE '%"administrator"%') a);
UPDATE \`${p}usermeta\` SET meta_value = CONCAT('user', user_id, '@example.test') WHERE meta_key = 'billing_email';
UPDATE \`${p}postmeta\` SET meta_value = CONCAT('customer', post_id, '@example.test') WHERE meta_key = '_billing_email';
SQL
	for t in wc_orders:billing_email:id wc_order_addresses:email:order_id wc_customer_lookup:email:customer_id; do
		IFS=: read -r tbl col idc <<<"$t"
		if [ -n "$(sql -N "$d" -e "SHOW TABLES LIKE '${p}${tbl}'")" ]; then
			sql "$d" -e "UPDATE \`${p}${tbl}\` SET \`$col\` = CONCAT('customer', \`$idc\`, '@example.test') WHERE \`$col\` <> ''"
		fi
	done
}

# ---------------------------------------------------------------------------
# Local (localwp.com) integration
# ---------------------------------------------------------------------------

LOCAL_APP="$HOME/Library/Application Support/Local"

# local_sites -> one line per Local site: id|name|domain|path|db-service|db-version
local_sites() {
	[ -f "$LOCAL_APP/sites.json" ] && command -v python3 >/dev/null || return 0
	python3 - "$LOCAL_APP/sites.json" <<'PY' 2>/dev/null || true
import json, os, sys
for sid, s in json.load(open(sys.argv[1])).items():
    db = next((v for v in s.get("services", {}).values() if v.get("role") == "db"), {})
    print("|".join([sid, s.get("name", ""), s.get("domain", ""), os.path.expanduser(s.get("path", "")),
                    db.get("name", "mysql"), db.get("version", "")]))
PY
}

# local_dump SITE OUTFILE: export a running Local site's database with Local's own mysqldump.
# Sets LOCAL_WPCONTENT. (Local's MySQL only accepts local socket connections, so Docker can't reach it.)
local_dump() {
	local line id path svc ver bin sock
	line=$(local_sites | awk -F'|' -v n="$1" '$2 == n' | head -1)
	[ -n "$line" ] || die "No Local site named '$1'. Local sites: $(local_sites | cut -d'|' -f2 | tr '\n' ' ')"
	IFS='|' read -r id _ _ path svc ver <<<"$line"
	sock="$LOCAL_APP/run/$id/mysql/mysqld.sock"
	[ -S "$sock" ] || die "Local site '$1' is not running. Start it in Local, then retry."
	bin=$(ls "$LOCAL_APP/lightning-services/$svc-$ver"+*/bin/darwin*/bin/mysqldump \
		"$LOCAL_APP/lightning-services/$svc-$ver"+*/bin/darwin*/bin/mariadb-dump 2>/dev/null | head -1 || true)
	[ -n "$bin" ] || die "Could not find Local's mysqldump for $svc $ver"
	info "Exporting the database of Local site '$1'"
	MYSQL_PWD=root "$bin" --socket="$sock" -uroot --single-transaction --no-tablespaces local | gzip >"$2"
	LOCAL_WPCONTENT="$path/app/public/wp-content"
}

# local_match HINT -> name of the Local site whose name or domain is HINT (a name, domain or URL).
local_match() {
	local h
	h=$(url_host "$1")
	local_sites | awk -F'|' -v n="$1" -v h="$h" '$2 == n || tolower($3) == h {print $2; exit}'
}

local_running() {
	local id
	id=$(local_sites | awk -F'|' -v n="$1" '$2 == n {print $1; exit}')
	[ -n "$id" ] && [ -S "$LOCAL_APP/run/$id/mysql/mysqld.sock" ]
}

wait_local() { # SITE: in a terminal, wait until the user starts it in Local
	until local_running "$1"; do
		[ -n "$HAS_TTY" ] && [ -z "$INIT_YES" ] || die "Local site '$1' is not running. Start it in Local, then retry."
		ask "Site '$1' isn't running. Start it in Local, then press Enter" "" >/dev/null
	done
}

abspath() { (cd "$(dirname "$1")" && printf '%s/%s' "$(pwd -P)" "$(basename "$1")"); }

detect_prefix() { # SQLFILE
	{ read_sql "$1" || true; } | grep -m1 -oE 'CREATE TABLE (IF NOT EXISTS )?`[A-Za-z0-9_]*usermeta`' |
		sed -E 's/.*`(.*)usermeta`/\1/' || true
}

load_sql() { # DB SQLFILE: import into a fresh database
	sql -e "DROP DATABASE IF EXISTS \`$1\`; CREATE DATABASE \`$1\`;"
	# MariaDB dumps start with a sandbox-mode line MySQL rejects.
	read_sql "$2" | sed '1{/enable the sandbox mode/d;}' | sql "$1"
}

detect_url() { sql -N "$1" -e "SELECT option_value FROM \`${2}options\` WHERE option_name = 'home'" 2>/dev/null || true; }

copy_wpcontent() { # SRC DEST [--delete]
	local rc=0 d protect=()
	mkdir -p "$2"
	# With --delete, keep the empty plugins/<slug> folders that sites use as mount points.
	if [ -n "${3:-}" ]; then
		for d in "$2"/plugins/*/; do
			d=$(basename "$d")
			[ -d "$2/plugins/$d" ] && [ ! -e "$1/plugins/$d" ] && [ -z "$(ls -A "$2/plugins/$d")" ] && protect+=(--filter="P /plugins/$d/")
		done
	fi
	rsync -a ${3:+"$3"} ${protect[@]+"${protect[@]}"} --exclude=node_modules/ --exclude=.git/ \
		--exclude=/cache/ --exclude=/upgrade/ --exclude=/ai1wm-backups/ --exclude=/updraft/ \
		--exclude=/backups-dup-lite/ --exclude=/wflogs/ --exclude=/et-cache/ --exclude=/upgrade-temp-backup/ --exclude=/uploads/wc-logs/ --exclude=/debug.log \
		--exclude=/object-cache.php --exclude=/advanced-cache.php --exclude=/db.php \
		"${1%/}/" "$2/" || rc=$?
	# 24 = files vanished during the copy (e.g. a build watcher); harmless here.
	[ $rc -eq 0 ] || [ $rc -eq 24 ] || die "Copying wp-content failed (rsync exit $rc)"
}

write_snap_meta() { # DIR, from the SNAP_* variables
	{
		printf 'SNAP_URL=%q\n' "$SNAP_URL"
		printf 'SNAP_PREFIX=%q\n' "$SNAP_PREFIX"
		printf 'SNAP_WPCONTENT=%q\n' "$SNAP_WPCONTENT"
		printf 'SNAP_DB=%q\n' "$SNAP_DB"
		printf 'SNAP_CREATED=%q\n' "$SNAP_CREATED"
		printf 'SNAP_SOURCE=%q\n' "$SNAP_SOURCE"
		printf 'SNAP_SOURCE_WPCONTENT=%q\n' "$SNAP_SOURCE_WPCONTENT"
		printf 'SNAP_SANITIZED=%q\n' "$SNAP_SANITIZED"
		printf 'SNAP_REFRESHED=%q\n' "$SNAP_REFRESHED"
	} >"$1/meta"
}

snap_users() { # NAME -> sites using this snapshot
	local f
	for f in "$BP_HOME"/sites/*.env; do
		[ -f "$f" ] && grep -qx "S_SNAPSHOT=$1" "$f" && printf ' %s' "$(basename "$f" .env)"
	done
	return 0
}

snap_add() {
	local name sqlf="" src="" url="" prefix="" do_sanitize="" empty="" link="" from_local="" source=""
	name=$(sanitize "${1:-}")
	[ -n "$name" ] || die "usage: branchpress snapshot add NAME (--from-local SITE | --sql FILE --wp-content DIR [--url URL] | --empty)"
	shift
	while [ $# -gt 0 ]; do
		case $1 in
			--sql) sqlf=$2; shift 2 ;;
			--wp-content) src=$2; shift 2 ;;
			--url) url=$2; shift 2 ;;
			--prefix) prefix=$2; shift 2 ;;
			--sanitize) do_sanitize=1; shift ;;
			--empty) empty=1; shift ;;
			--link) link=1; shift ;;
			--from-local) from_local=$2; shift 2 ;;
			--source) source=$2; shift 2 ;; # internal: set by snapshot import
			*) die "Unknown option: $1" ;;
		esac
	done
	ensure_infra
	local dir="$BP_HOME/snapshots/$name" sdb wpcontent
	[ -e "$dir" ] && die "Snapshot '$name' already exists. Remove it first: branchpress snapshot rm $name"
	SNAP_SOURCE_WPCONTENT=""
	if [ -n "$from_local" ]; then
		tmp=$(mktemp -d)
		local_dump "$from_local" "$tmp/db.sql.gz"
		sqlf="$tmp/db.sql.gz"
		src=$LOCAL_WPCONTENT
		source="local:$from_local"
	fi
	sdb="snap_$(db_ident "$name")"
	PARTIAL_SNAP_DIR=$dir
	PARTIAL_SNAP_DB=$sdb

	if [ -n "$empty" ]; then
		mkdir -p "$dir"
		docker run --rm --entrypoint tar "$BRANCHPRESS_WP_IMAGE" -C /usr/src/wordpress -cf - wp-content | tar -C "$dir" -xf -
		sql -e "DROP DATABASE IF EXISTS \`$sdb\`; CREATE DATABASE \`$sdb\`;"
		wpcontent="$dir/wp-content"
		url="" prefix="wp_" source=empty
	else
		[ -f "$sqlf" ] || die "--sql file not found: $sqlf"
		[ -d "$src" ] || die "--wp-content folder not found: $src"
		if [ -z "$source" ]; then
			source="sql:$(abspath "$sqlf")"
			SNAP_SOURCE_WPCONTENT=$(cd "$src" && pwd -P)
		fi
		if [ -z "$prefix" ]; then
			prefix=$(detect_prefix "$sqlf")
			[ -n "$prefix" ] || die "Could not detect the table prefix; pass --prefix (e.g. --prefix wp_)"
		fi
		mkdir -p "$dir"
		info "Importing $(basename "$sqlf") (prefix $prefix)"
		load_sql "$sdb" "$sqlf"
		if [ -z "$url" ]; then
			url=$(detect_url "$sdb" "$prefix")
			if [ -n "$url" ]; then info "Detected site URL: $url"; else warn "Could not detect the site URL: URLs in the data will not be rewritten (pass --url)"; fi
		fi
		[ -n "$do_sanitize" ] && snap_sanitize "$sdb" "$prefix"
		if [ -n "$link" ]; then
			wpcontent=$(cd "$src" && pwd -P)
			local f
			for f in object-cache.php advanced-cache.php db.php; do
				[ -f "$wpcontent/$f" ] && warn "$wpcontent/$f is a caching drop-in and may break sites; consider removing it or not using --link"
			done
		else
			info "Copying wp-content (skipping caches, backups, node_modules, .git and cache drop-ins)"
			copy_wpcontent "$src" "$dir/wp-content"
			wpcontent="$dir/wp-content"
		fi
	fi
	SNAP_URL=$url SNAP_PREFIX=$prefix SNAP_WPCONTENT=$wpcontent SNAP_DB=$sdb SNAP_CREATED=$(date +%Y-%m-%d)
	SNAP_SOURCE=$source SNAP_SANITIZED=$do_sanitize SNAP_REFRESHED=""
	write_snap_meta "$dir"
	PARTIAL_SNAP_DIR="" PARTIAL_SNAP_DB=""
	if [ -n "$INIT_RUNNING" ]; then info "Snapshot '$name' ready"
	else info "Snapshot '$name' ready. Use it for a plugin: branchpress use $name  (inside the plugin repo)"; fi
}

# refresh NAME [--from-local SITE | --import FILE]: copy the data again from where it came from.
# Sites keep their own database copy until 'branchpress reset'; wp-content files update right away.
snap_refresh() {
	local name=${1:?usage: branchpress snapshot refresh NAME [--from-local SITE | --import FILE]} from_local="" import=""
	local sqlf src url="" prefix newdb tables renames="" t users
	shift
	while [ $# -gt 0 ]; do
		case $1 in
			--from-local) from_local=$2; shift 2 ;;
			--import) import=$2; shift 2 ;;
			*) die "Unknown option: $1" ;;
		esac
	done
	load_snapshot "$name"
	[ -n "$from_local" ] && SNAP_SOURCE="local:$from_local"
	if [ -n "$import" ]; then
		import=$(clean_path "$import")
		[ -f "$import" ] || die "File not found: $import"
		SNAP_SOURCE="import:$(abspath "$import")"
	fi
	ensure_infra
	tmp=$(mktemp -d)
	case $SNAP_SOURCE in
		local:*)
			local_dump "${SNAP_SOURCE#local:}" "$tmp/db.sql.gz"
			sqlf="$tmp/db.sql.gz" src=$LOCAL_WPCONTENT
			;;
		import:*)
			t=${SNAP_SOURCE#import:}
			[ -f "$t" ] || die "The file '$name' was imported from is gone: $t. Pass the new one: branchpress snapshot refresh $name --import FILE"
			info "Unpacking $t"
			tar -xzf "$t" -C "$tmp"
			[ -f "$tmp/meta" ] && [ -f "$tmp/db.sql.gz" ] || die "$t is not a branchpress snapshot export"
			# shellcheck disable=SC1091
			url=$(SNAP_URL="" && . "$tmp/meta" && printf %s "$SNAP_URL")
			sqlf="$tmp/db.sql.gz" src="$tmp/wp-content"
			;;
		sql:*)
			sqlf=${SNAP_SOURCE#sql:} src=$SNAP_SOURCE_WPCONTENT url=$SNAP_URL
			[ -f "$sqlf" ] || die "Dump not found: $sqlf"
			;;
		empty) die "'$name' is an empty WordPress; there is nothing to refresh" ;;
		*) die "branchpress doesn't know where '$name' came from. Tell it once: branchpress snapshot refresh $name --from-local SITE (or --import FILE)" ;;
	esac
	prefix=$(detect_prefix "$sqlf")
	[ -n "$prefix" ] || prefix=$SNAP_PREFIX
	newdb="${SNAP_DB}__new"
	PARTIAL_DB=$newdb
	info "Importing the new database"
	load_sql "$newdb" "$sqlf"
	[ -n "$url" ] || url=$(detect_url "$newdb" "$prefix")
	[ -n "$SNAP_SANITIZED" ] && snap_sanitize "$newdb" "$prefix"
	# Swap the new tables in. Each site has its own database copy, so running sites are unaffected.
	tables=$(sql -N -e "SELECT table_name FROM information_schema.tables WHERE table_schema = '$newdb'")
	[ -n "$tables" ] || die "The new database is empty"
	for t in $tables; do renames="${renames:+$renames, }\`$newdb\`.\`$t\` TO \`$SNAP_DB\`.\`$t\`"; done
	PARTIAL_DB=""
	sql -e "DROP DATABASE IF EXISTS \`$SNAP_DB\`; CREATE DATABASE \`$SNAP_DB\`; RENAME TABLE $renames; DROP DATABASE \`$newdb\`;"
	case $SNAP_WPCONTENT in
		"$BP_HOME"/*) info "Updating wp-content"; copy_wpcontent "$src" "$SNAP_WPCONTENT" --delete ;;
		*) info "wp-content is linked to $SNAP_WPCONTENT; nothing to copy" ;;
	esac
	[ "$prefix" != "$SNAP_PREFIX" ] && warn "Table prefix changed ($SNAP_PREFIX → $prefix): run 'branchpress reset' in every worktree using '$name'"
	SNAP_URL=$url SNAP_PREFIX=$prefix SNAP_REFRESHED=$(date +%Y-%m-%d)
	write_snap_meta "$SNAP_DIR"
	info "Snapshot '$name' refreshed from $(describe_source)"
	users=$(snap_users "$name")
	[ -n "$users" ] && info "Sites using it see the new files now. For the new data, run 'branchpress reset' in their worktrees:$users"
	return 0
}

snap_ls() {
	local d any="" m
	printf '%-20s %-11s %-28s %-7s %s\n' NAME COPIED SOURCE SIZE URL
	for d in "$BP_HOME"/snapshots/*/; do
		[ -f "$d/meta" ] || continue
		any=1
		(
			load_snapshot "$(basename "$d")"
			printf '%-20s %-11s %-28s %-7s %s\n' "$(basename "$d")" "${SNAP_REFRESHED:-$SNAP_CREATED}" "$(describe_source)" \
				"$(du -sh "$SNAP_WPCONTENT" 2>/dev/null | cut -f1)" "${SNAP_URL:-(fresh install)}"
		)
	done
	[ -n "$any" ] || { echo "(no snapshots — see: branchpress snapshot help)"; return 0; }
	m=$( [ -f "$SNAP_MAP" ] && cat "$SNAP_MAP" || true)
	echo
	echo "Default: ${BRANCHPRESS_DEFAULT_SNAPSHOT:-(none)}"
	[ -n "$m" ] && echo "Plugin choices (branchpress use): $(echo "$m" | sed 's/=/ → /' | tr '\n' ',' | sed 's/,$//; s/,/, /g')"
	return 0
}

snap_rm() {
	local name=${1:?usage: branchpress snapshot rm NAME [--force]} force=${2:-} n c users
	load_snapshot "$name"
	# Sites bind-mount the snapshot's wp-content, so they cannot outlive it.
	users=$(snap_users "$name")
	for c in $(docker ps -aq --filter "label=$PFX.site"); do
		docker inspect -f '{{range .Mounts}}{{.Source}}{{"\n"}}{{end}}' "$c" | grep -q "${SNAP_WPCONTENT#/}$" || continue
		n=$(docker inspect -f "{{index .Config.Labels \"$PFX.site\"}}" "$c")
		case " $users " in *" $n "*) ;; *) users="$users $n" ;; esac
	done
	if [ -n "$users" ]; then
		[ "$force" = "--force" ] || die "Used by sites:$users. Remove them with 'branchpress down --purge', or run: branchpress snapshot rm $name --force"
		for n in $users; do teardown "$n" purge; done
	fi
	ensure_infra
	sql -e "DROP DATABASE IF EXISTS \`$SNAP_DB\`"
	rm_tree "$SNAP_DIR" || die "Could not delete $SNAP_DIR"
	if [ -f "$SNAP_MAP" ] && grep -q "=$name\$" "$SNAP_MAP"; then
		awk -F= -v v="$name" '$2 != v' "$SNAP_MAP" >"$SNAP_MAP.tmp" && mv "$SNAP_MAP.tmp" "$SNAP_MAP"
		info "Plugins that used '$name' will ask again on their next new site"
	fi
	info "Removed snapshot $name"
}

snap_export() {
	local name=${1:?usage: branchpress snapshot export NAME FILE.tar.gz} file=${2:?usage: branchpress snapshot export NAME FILE.tar.gz}
	load_snapshot "$name"
	ensure_infra
	tmp=$(mktemp -d)
	info "Dumping database"
	docker exec -e MYSQL_PWD="$DB_PASS" "$DB" mysqldump -uroot --single-transaction --no-tablespaces --set-gtid-purged=OFF "$SNAP_DB" | gzip >"$tmp/db.sql.gz"
	cp "$SNAP_DIR/meta" "$tmp/meta"
	ln -s "$SNAP_WPCONTENT" "$tmp/wp-content"
	info "Packing wp-content"
	# Skip empty plugins/<slug> folders: mount points left by sites, not real plugins.
	local ex=() d
	for d in "$SNAP_WPCONTENT"/plugins/*/; do
		[ -d "$d" ] && [ -z "$(ls -A "$d")" ] && ex+=(--exclude "wp-content/plugins/$(basename "$d")")
	done
	tar -czhf "$file" ${ex[@]+"${ex[@]}"} -C "$tmp" meta db.sql.gz wp-content
	info "Wrote $file ($(du -h "$file" | cut -f1)). It contains real site data — share it privately."
}

snap_import() {
	local file=${1:?usage: branchpress snapshot import FILE.tar.gz [NAME]} name url prefix
	file=$(clean_path "$file")
	[ -f "$file" ] || die "File not found: $file"
	name=${2:-$(basename "$file" | sed -E 's/\.tar\.gz$|\.tgz$//')}
	tmp=$(mktemp -d)
	info "Unpacking $file"
	tar -xzf "$file" -C "$tmp"
	[ -f "$tmp/meta" ] && [ -f "$tmp/db.sql.gz" ] || die "$file is not a branchpress snapshot export"
	# shellcheck disable=SC1091
	url=$(SNAP_URL="" && . "$tmp/meta" && printf %s "$SNAP_URL")
	# shellcheck disable=SC1091
	prefix=$(SNAP_PREFIX="wp_" && . "$tmp/meta" && printf %s "$SNAP_PREFIX")
	snap_add "$name" --sql "$tmp/db.sql.gz" --wp-content "$tmp/wp-content" --url "$url" --prefix "$prefix" \
		--source "import:$(abspath "$file")"
}

cmd_snapshot() {
	local sub=${1:-help}
	[ $# -gt 0 ] && shift
	case $sub in
		add) snap_add "$@" ;;
		ls | list) snap_ls ;;
		rm | remove) snap_rm "$@" ;;
		refresh) snap_refresh "$@" ;;
		export) snap_export "$@" ;;
		import) snap_import "$@" ;;
		*)
			cat <<'EOF'
branchpress snapshot — realistic data that every site is cloned from

  add NAME --from-local SITE [--sanitize]
        Copy a running Local (localwp.com) site: database + wp-content.
  add NAME --sql FILE[.gz] --wp-content DIR [--url ORIGINAL_URL] [--prefix wp_] [--sanitize] [--link]
        Import a database dump + wp-content folder (from production or staging).
        The original URL and table prefix are detected from the dump when not given.
        --sanitize  replace customer emails with @example.test addresses
        --link      use DIR in place instead of copying it (saves disk; shared by all sites)
  add NAME --empty
        Fresh WordPress, no data.
  ls                        List snapshots, where each was copied from, and which plugins use them
  refresh NAME [--from-local SITE | --import FILE]
        Copy the data again from its source (a Local site, export file or dump). Files update
        for running sites right away; their data updates on 'branchpress reset'.
        Pass --from-local/--import to change where it comes from.
  rm NAME [--force]         Delete a snapshot (--force also deletes sites using it)
  export NAME FILE.tar.gz   Pack a snapshot to hand to a teammate
  import FILE.tar.gz [NAME] Load a teammate's export
EOF
			;;
	esac
}

# ---------------------------------------------------------------------------
# init: guided first-time setup
# ---------------------------------------------------------------------------

HAS_TTY=""
INIT_YES=""
INIT_RUNNING=""
( exec </dev/tty ) 2>/dev/null && HAS_TTY=1

# ask PROMPT DEFAULT -> answer (DEFAULT when --yes or no terminal)
ask() {
	local a=""
	if [ -n "$HAS_TTY" ] && [ -z "$INIT_YES" ]; then
		printf '\033[1m?\033[0m %s %s' "$1" "${2:+[$2] }" >/dev/tty
		IFS= read -r a </dev/tty || a=""
	fi
	printf '%s' "${a:-$2}"
}
confirm() { case $(ask "$1 (Y/n)" "y") in [nN]*) return 1 ;; *) return 0 ;; esac; }

# Clean a path typed or dragged into the terminal: quotes, "\ " escapes, leading ~.
clean_path() {
	local p=$1
	p=${p#"${p%%[![:space:]]*}"}; p=${p%"${p##*[![:space:]]}"}
	p=${p#\'}; p=${p%\'}; p=${p#\"}; p=${p%\"}
	p=${p//\\ / }
	case $p in "~"*) p="$HOME${p#\~}" ;; esac
	printf '%s' "$p"
}

set_conf() { # KEY VALUE
	local v=${2//|/\\|}
	if grep -q "^$1=" "$CONF"; then sed -i.bak "s|^$1=.*|$1=\"$v\"|" "$CONF" && rm -f "$CONF.bak"
	else printf '%s="%s"\n' "$1" "$2" >>"$CONF"; fi
}

step() { printf '\n\033[1;36m[%s/5]\033[0m \033[1m%s\033[0m\n' "$1" "$2" >&2; }

init_docker() {
	export PATH="$PATH:$HOME/.orbstack/bin"
	if ! command -v docker >/dev/null; then
		if [ "$(uname)" = Darwin ] && command -v brew >/dev/null; then
			confirm "Docker is not installed. Install OrbStack (lightweight Docker for Mac) with Homebrew?" ||
				die "Install OrbStack (https://orbstack.dev) or Docker Desktop, then run: branchpress init"
			brew install --cask orbstack
		else
			die "Docker is not installed. Install OrbStack (https://orbstack.dev), Docker Desktop or Docker Engine, then run: branchpress init"
		fi
	fi
	if ! docker info >/dev/null 2>&1; then
		[ "$(uname)" = Darwin ] && { open -a OrbStack 2>/dev/null || open -a Docker 2>/dev/null || true; }
		info "Waiting for Docker to start (finish the OrbStack/Docker window if one opened)…"
		local i=0
		until docker info >/dev/null 2>&1; do
			i=$((i + 1))
			[ $i -gt 180 ] && die "Docker did not start. Start it yourself, then run: branchpress init"
			sleep 1
		done
	fi
	info "Docker is running"
}

init_snapshot() { # -> sets INIT_SNAPSHOT
	local import=$1 from_local=$2 empty=$3 choice n line sites name file
	if [ -n "$import" ]; then
		file=$(clean_path "$import")
		name=$(basename "$file" | sed -E 's/\.tar\.gz$|\.tgz$//')
		name=$(sanitize "$name")
		if [ -f "$BP_HOME/snapshots/$name/meta" ]; then info "Snapshot '$name' already exists, keeping it"; else snap_import "$file" "$name"; fi
		INIT_SNAPSHOT=$name
		return
	fi
	if [ -n "$from_local" ]; then
		name=$(sanitize "$from_local")
		if [ -f "$BP_HOME/snapshots/$name/meta" ]; then info "Snapshot '$name' already exists, keeping it"; else snap_add "$name" --from-local "$from_local"; fi
		INIT_SNAPSHOT=$name
		return
	fi
	if [ -n "$empty" ]; then
		[ -f "$BP_HOME/snapshots/blank/meta" ] || snap_add blank --empty
		INIT_SNAPSHOT=blank
		return
	fi
	# Interactive: keep an existing snapshot, or pick a source.
	local existing
	existing=$(ls "$BP_HOME/snapshots" 2>/dev/null | tr '\n' ' ')
	if [ -n "$existing" ]; then
		info "Existing snapshots: $existing"
		INIT_SNAPSHOT=$(ask "Which one should be the default?" "${BRANCHPRESS_DEFAULT_SNAPSHOT:-${existing%% *}}")
		[ -f "$BP_HOME/snapshots/$INIT_SNAPSHOT/meta" ] || die "No snapshot named '$INIT_SNAPSHOT'"
		return
	fi
	if [ -z "$HAS_TTY" ] || [ -n "$INIT_YES" ]; then
		info "No snapshot yet: using an empty WordPress (rerun with --import FILE or --from-local SITE for real data)"
		init_snapshot "" "" 1
		return
	fi
	sites=$(local_sites)
	echo "  Where should the test data come from?" >&2
	echo "    1) A snapshot file from a teammate (.tar.gz)" >&2
	[ -n "$sites" ] && echo "    2) Copy one of my Local sites" >&2
	echo "    3) Empty WordPress (no data)" >&2
	choice=$(ask "Choose" "1")
	case $choice in
		1)
			file=$(ask "Path to the .tar.gz file (you can drag it here)" "")
			[ -n "$file" ] || die "No file given"
			init_snapshot "$file" "" ""
			;;
		2)
			[ -n "$sites" ] || die "No Local sites found"
			n=0
			while IFS='|' read -r _ name line _; do n=$((n + 1)); printf '    %d) %s  (%s)\n' "$n" "$name" "$line" >&2; done <<<"$sites"
			choice=$(ask "Which site?" "1")
			name=$(echo "$sites" | sed -n "${choice}p" | cut -d'|' -f2)
			[ -n "$name" ] || die "Invalid choice: $choice"
			wait_local "$name"
			init_snapshot "" "$name" ""
			;;
		3) init_snapshot "" "" 1 ;;
		*) die "Invalid choice: $choice" ;;
	esac
}

cmd_init() {
	local plugins_dir="" import="" from_local="" empty="" snapshot="" no_claude="" no_start="" guess root common slug
	while [ $# -gt 0 ]; do
		case $1 in
			--plugins-dir) plugins_dir=$2; shift 2 ;;
			--import) import=$2; shift 2 ;;
			--from-local) from_local=$2; shift 2 ;;
			--empty) empty=1; shift ;;
			--snapshot) snapshot=$2; shift 2 ;;
			--no-claude) no_claude=1; shift ;;
			--no-start) no_start=1; shift ;;
			-y | --yes) INIT_YES=1; shift ;;
			*) die "Unknown option: $1 (see: branchpress help)" ;;
		esac
	done
	INIT_RUNNING=1
	printf '\n\033[1mbranchpress init\033[0m — one WordPress test site per git worktree\n' >&2

	step 1 "Docker"
	init_docker

	step 2 "Install"
	cmd_setup --quiet
	info "MySQL and Mailpit are running; 'branchpress' is in ~/.local/bin"

	step 3 "Plugin repos"
	if root=$(git rev-parse --show-toplevel 2>/dev/null); then
		common=$(git -C "$root" rev-parse --path-format=absolute --git-common-dir)
		guess=$(dirname "$(dirname "$common")")
	fi
	guess=${BRANCHPRESS_PLUGINS_DIR:-${guess:-$HOME/plugins}}
	plugins_dir=$(clean_path "${plugins_dir:-$(ask "Folder that holds your plugin repos" "$guess")}")
	mkdir -p "$plugins_dir"
	set_conf BRANCHPRESS_PLUGINS_DIR "$plugins_dir"
	BRANCHPRESS_PLUGINS_DIR=$plugins_dir
	info "Plugins folder: $plugins_dir"

	step 4 "Test data"
	INIT_SNAPSHOT=""
	if [ -n "$snapshot" ]; then
		[ -f "$BP_HOME/snapshots/$snapshot/meta" ] || die "No snapshot named '$snapshot'"
		INIT_SNAPSHOT=$snapshot
	else
		init_snapshot "$import" "$from_local" "$empty"
	fi
	set_conf BRANCHPRESS_DEFAULT_SNAPSHOT "$INIT_SNAPSHOT"
	BRANCHPRESS_DEFAULT_SNAPSHOT=$INIT_SNAPSHOT
	info "Default snapshot: $INIT_SNAPSHOT"

	step 5 "Claude Code"
	if [ -n "$no_claude" ]; then
		info "Skipped"
	elif ! command -v claude >/dev/null; then
		info "Claude Code not found, skipped (install the plugin later: see README)"
	elif [ -e "$HOME/.claude/skills/branchpress" ] || claude plugin list 2>/dev/null | grep -q 'branchpress'; then
		info "branchpress skill already installed"
	elif confirm "Install the branchpress skill for Claude Code?"; then
		claude plugin marketplace add thithiennta/branchpress >/dev/null 2>&1 || true
		if claude plugin install branchpress@branchpress >/dev/null 2>&1; then info "Installed — restart Claude Code to load it"
		else warn "Could not install automatically. In Claude Code run: /plugin marketplace add thithiennta/branchpress"; fi
	fi

	printf '\n\033[1;32m✔ branchpress is ready.\033[0m\n' >&2
	if [ -z "$no_start" ] && root=$(git rev-parse --show-toplevel 2>/dev/null); then
		slug=$(slug_of "$root")
		if confirm "Start a test site for $slug now?"; then
			if [ -n "$HAS_TTY" ]; then cmd_up --open; else cmd_up; fi
			return
		fi
	fi
	cat >&2 <<EOF

Next: in any plugin worktree run

  branchpress up --open      start this worktree's site and open wp-admin
  branchpress help           all commands
EOF
}

# use [NAME | --from-local SITE | --import FILE | --empty | --clear] [--plugin SLUG]
# Choose which snapshot a plugin's new sites are cloned from (saved per developer).
cmd_use() {
	local name="" plugin="" import="" from_local="" empty="" clear="" root="" m hint n
	while [ $# -gt 0 ]; do
		case $1 in
			--plugin) plugin=$2; shift 2 ;;
			--from-local) from_local=$2; shift 2 ;;
			--import) import=$2; shift 2 ;;
			--empty) empty=1; shift ;;
			--clear) clear=1; shift ;;
			-*) die "Unknown option: $1 (see: branchpress help)" ;;
			*) name=$1; shift ;;
		esac
	done
	root=$(git rev-parse --show-toplevel 2>/dev/null) || root=""
	if [ -z "$plugin" ]; then
		if [ -n "$root" ]; then
			plugin=$(slug_of "$root")
		elif [ -z "$name$import$from_local$empty$clear" ]; then
			snap_ls
			return
		else
			die "Run this inside a plugin repo, or pass --plugin SLUG"
		fi
	fi
	[ -n "$root" ] && [ "$(slug_of "$root")" != "$plugin" ] && root=""

	if [ -n "$clear" ]; then
		map_del "$plugin"
		info "Cleared the snapshot choice for $plugin"
		return
	fi

	if [ -z "$name$import$from_local$empty" ]; then
		m=$(map_get "$plugin")
		echo "Plugin $plugin"
		echo "  your choice:   ${m:-(none)}"
		if [ -n "$root" ]; then
			hint=$(conf_get "$root/.branchpress" snapshot | tail -1)
			if [ -n "$hint" ]; then
				n=$(snap_match "$hint")
				echo "  .branchpress:  snapshot=$hint → ${n:-not on this machine}"
			fi
		fi
		echo "  default:       ${BRANCHPRESS_DEFAULT_SNAPSHOT:-(none)}"
		echo
		snap_ls
		return
	fi

	INIT_RUNNING=1
	if [ -n "$name" ]; then
		[ -f "$BP_HOME/snapshots/$name/meta" ] || die "No snapshot named '$name' (see: branchpress snapshot ls)"
		INIT_SNAPSHOT=$name
	else
		[ -n "$from_local" ] && wait_local "$from_local"
		init_snapshot "$import" "$from_local" "$empty"
	fi
	map_set "$plugin" "$INIT_SNAPSHOT"
	info "$plugin now uses snapshot '$INIT_SNAPSHOT' for new sites"
	if [ -n "$root" ]; then
		detect
		load_state
		if [ -f "$STATE" ] && [ "$S_SNAPSHOT" != "$INIT_SNAPSHOT" ]; then
			info "This worktree's site still uses '$S_SNAPSHOT'. Switch it (re-clones its data): branchpress up --snapshot $INIT_SNAPSHOT"
		fi
	fi
	return 0
}

cmd_help() {
	cat <<'EOF'
branchpress — one WordPress test site per plugin worktree

Setup
  branchpress init                      Guided first-time setup (Docker, data, Claude skill)
        [--plugins-dir DIR] [--import FILE | --from-local SITE | --empty | --snapshot NAME]
        [--no-claude] [--no-start] [--yes]
  branchpress setup                     One-time: WP-CLI, images, shared MySQL + Mailpit, puts branchpress on PATH
  branchpress snapshot ...              Manage data snapshots (branchpress snapshot help)

Test data per plugin (saved per developer; asked once when it's unclear)
  branchpress use                       Show which snapshot this plugin uses and why
  branchpress use NAME                  Use snapshot NAME for this plugin's new sites
  branchpress use --from-local SITE     Copy a Local site into a snapshot and use it
  branchpress use --import FILE.tar.gz  Load a teammate's export and use it
  branchpress use --empty | --clear     Empty WordPress / forget the choice
        [--plugin SLUG]                 for a plugin other than the current repo

In a plugin worktree
  branchpress up [--snapshot NAME] [--with SPEC]... [--fresh] [--open]
        Start (or resume) this worktree's site. --with mounts another plugin:
          --with other-plugin          same-branch worktree if it exists, else its main checkout
          --with other-plugin@branch   that plugin's worktree on that branch
          --with ../path/to/plugin     any folder
        --fresh re-clones the database from the snapshot.
  branchpress down [--purge]            Stop the site (--purge also deletes its database)
  branchpress url | open                Print the URL / open wp-admin logged in
  branchpress wp <args>                 WP-CLI against this site
  branchpress sql                       MySQL shell on this site's database
  branchpress logs [--php]              Apache log, or PHP debug.log

Everywhere
  branchpress ls                        All sites and their URLs
  branchpress prune                     Delete sites whose worktree was removed (also runs on every up/ls)
  branchpress du                        Disk used by snapshots, sites and shared containers
  branchpress halt                      Stop every branchpress container (frees RAM, keeps data)

Per-repo file .branchpress (optional, commit it):
  slug=my-plugin          plugin folder name, if it differs from the repo folder name
  snapshot=abc.dev        the team's dev site for this plugin: a snapshot name, or the domain
                          it was copied from (matched on each machine; asks if not found)
  with=woocommerce-addon  companion plugin, one line each (same SPEC as --with)
EOF
}

case ${1:-help} in
	init) shift; cmd_init "$@" ;;
	setup) shift; cmd_setup "$@" ;;
	up | start) shift; cmd_up "$@" ;;
	down | stop) shift; cmd_down "$@" ;;
	reset) shift; cmd_up --fresh "$@" ;;
	ls | list | status) cmd_ls ;;
	prune) cmd_prune ;;
	du | disk) cmd_du ;;
	halt) cmd_halt ;;
	url) cmd_url ;;
	open) cmd_open ;;
	wp) shift; cmd_wp "$@" ;;
	sql) shift; cmd_sql "$@" ;;
	logs) shift; cmd_logs "$@" ;;
	snapshot | snap) shift; cmd_snapshot "$@" ;;
	use) shift; cmd_use "$@" ;;
	version | -v | --version) echo "branchpress $BP_VERSION" ;;
	help | -h | --help) cmd_help ;;
	*) die "Unknown command: $1 (see: branchpress help)" ;;
esac
